{
  "$schema": "https://raw.githubusercontent.com/Monster-Orange/den/main/schemas/den.theme.v1.json",
  "schema": "den.theme/v1",
  "id": "commit",
  "name": "Commit",
  "version": "1.0.0",
  "description": "An homage to GitHub's interface: cool neutral grays, a clear blue accent, system fonts. Colors from the MIT-licensed Primer design system.",
  "author": "Monster Orange",
  "license": "MIT",
  "homepage": "https://github.com/Monster-Orange/den-themes/tree/main/themes/commit",
  "default_mode": "dark",
  "type": {
    "sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Noto Sans\", Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, monospace",
    "display": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Noto Sans\", Helvetica, Arial, sans-serif",
    "ja": "\"Hiragino Sans\", \"Hiragino Kaku Gothic ProN\", \"Noto Sans JP\", \"Yu Gothic\", Meiryo, sans-serif"
  },
  "shape": {
    "radius": "8px",
    "radius-button": "6px",
    "density": "comfortable"
  },
  "mark": {
    "svg": "mark.svg",
    "shape": "rounded"
  },
  "modes": {
    "light": {
      "bg": "#f6f8fa",
      "surface": "#ffffff",
      "raised": "#ffffff",
      "sunken": "#eef1f4",
      "text": "#1f2328",
      "muted": "#59636e",
      "faint": "#656e7b",
      "border": "#d1d9e0",
      "border-strong": "#7c8c9e",
      "accent": "#0969da",
      "accent-text": "#0969da",
      "accent-fill": "#0969da",
      "on-accent": "#ffffff",
      "ok": "#1a7d36",
      "warn": "#946300",
      "bad": "#cf222e",
      "remote": "#0d7882",
      "shadow": "0 8px 28px rgb(31 35 40 / 0.14)",
      "bar": "none"
    },
    "dark": {
      "bg": "#0d1117",
      "surface": "#161b22",
      "raised": "#1c2330",
      "sunken": "#0b0f14",
      "text": "#e6edf3",
      "muted": "#9198a1",
      "faint": "#838a95",
      "border": "#30363d",
      "border-strong": "#646d7a",
      "accent": "#4493f8",
      "accent-text": "#58a6ff",
      "accent-fill": "#1f6feb",
      "on-accent": "#ffffff",
      "ok": "#3fb950",
      "warn": "#d29922",
      "bad": "#f85149",
      "remote": "#39c5cf",
      "shadow": "0 12px 30px rgb(0 0 0 / 0.5)",
      "bar": "none"
    }
  }
}
