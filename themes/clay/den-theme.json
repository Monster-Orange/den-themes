{
  "$schema": "https://raw.githubusercontent.com/Monster-Orange/den/main/schemas/den.theme.v1.json",
  "schema": "den.theme/v1",
  "id": "clay",
  "name": "Clay",
  "version": "1.0.0",
  "description": "An homage to Anthropic's Claude interface: warm ivory and charcoal, a terracotta accent, serif headings.",
  "author": "Monster Orange",
  "license": "MIT",
  "homepage": "https://github.com/Monster-Orange/den-themes/tree/main/themes/clay",
  "default_mode": "light",
  "type": {
    "sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Noto Sans\", Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, monospace",
    "display": "ui-serif, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
    "ja": "\"Hiragino Sans\", \"Hiragino Kaku Gothic ProN\", \"Noto Sans JP\", \"Yu Gothic\", Meiryo, sans-serif"
  },
  "shape": {
    "radius": "10px",
    "radius-button": "8px",
    "density": "comfortable"
  },
  "mark": {
    "svg": "mark.svg",
    "shape": "rounded"
  },
  "modes": {
    "light": {
      "bg": "#f7f4ec",
      "surface": "#fdfcf8",
      "raised": "#ffffff",
      "sunken": "#efeadf",
      "text": "#2a2723",
      "muted": "#5f5a52",
      "faint": "#6e6961",
      "border": "#e3ddd0",
      "border-strong": "#8f8675",
      "accent": "#c4633f",
      "accent-text": "#a64d2e",
      "accent-fill": "#b0543a",
      "on-accent": "#ffffff",
      "ok": "#3a773d",
      "warn": "#8f5d10",
      "bad": "#b3392f",
      "remote": "#2d6a80",
      "shadow": "0 6px 24px rgb(60 40 20 / 0.10)",
      "bar": "none"
    },
    "dark": {
      "bg": "#262624",
      "surface": "#2f2e2b",
      "raised": "#383633",
      "sunken": "#1f1e1c",
      "text": "#ece9e1",
      "muted": "#b8b2a7",
      "faint": "#a29e96",
      "border": "#403e3a",
      "border-strong": "#857f76",
      "accent": "#d4785a",
      "accent-text": "#e08b6d",
      "accent-fill": "#d4785a",
      "on-accent": "#1f1e1c",
      "ok": "#84c487",
      "warn": "#e3b05c",
      "bad": "#f08679",
      "remote": "#7fb6cf",
      "shadow": "0 12px 30px rgb(0 0 0 / 0.45)",
      "bar": "none"
    }
  }
}
