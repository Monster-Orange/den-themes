{
  "$schema": "https://raw.githubusercontent.com/Monster-Orange/den/main/schemas/den.theme.v1.json",
  "schema": "den.theme/v1",
  "id": "starter",
  "name": "Starter",
  "version": "0.1.0",
  "description": "A plain, valid theme to copy and change.",
  "author": "Your Name",
  "license": "MIT",
  "default_mode": "light",
  "type": {
    "sans": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "mono": "ui-monospace, Menlo, Consolas, monospace"
  },
  "shape": {
    "radius": "6px",
    "radius-button": "6px",
    "density": "comfortable"
  },
  "mark": {
    "svg": "mark.svg",
    "shape": "rounded"
  },
  "modes": {
    "light": {
      "bg": "#f5f5f5",
      "surface": "#ffffff",
      "raised": "#ffffff",
      "sunken": "#ebebeb",
      "text": "#1a1a1a",
      "muted": "#555555",
      "faint": "#6a6a6a",
      "border": "#dddddd",
      "border-strong": "#878787",
      "accent": "#3366cc",
      "accent-text": "#2a55aa",
      "accent-fill": "#2a55aa",
      "on-accent": "#ffffff",
      "ok": "#297829",
      "warn": "#8a6000",
      "bad": "#c02020",
      "remote": "#1f6f7f",
      "shadow": "0 6px 20px rgb(0 0 0 / 0.15)",
      "bar": "none"
    },
    "dark": {
      "bg": "#141414",
      "surface": "#1c1c1c",
      "raised": "#242424",
      "sunken": "#101010",
      "text": "#eeeeee",
      "muted": "#aaaaaa",
      "faint": "#8b8b8b",
      "border": "#333333",
      "border-strong": "#6e6e6e",
      "accent": "#6f9ae8",
      "accent-text": "#86aaee",
      "accent-fill": "#3366cc",
      "on-accent": "#ffffff",
      "ok": "#5cbf5c",
      "warn": "#d9a635",
      "bad": "#f06060",
      "remote": "#4fb8c9",
      "shadow": "0 10px 28px rgb(0 0 0 / 0.5)",
      "bar": "none"
    }
  }
}
